# MCP Server Dockerfile
#
# Runs the MCP server with Gradio debug interface

FROM python:3.11-slim

LABEL maintainer="FreeCAD MCP"
LABEL description="MCP Server with Gradio interface"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install cloudflared for tunnels
RUN curl -L --output cloudflared.deb https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb \
    && dpkg -i cloudflared.deb \
    && rm cloudflared.deb

# Create app directory
WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt .
COPY README.md .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY pyproject.toml .

# Install package
RUN pip install --no-cache-dir -e .

# Environment
ENV PYTHONUNBUFFERED=1
ENV FREECAD_HOST=localhost
ENV FREECAD_PORT=9875
ENV INFERENCE_HOST=localhost
ENV INFERENCE_PORT=5555
ENV GRADIO_PORT=7860
ENV ENABLE_TUNNEL=true

# Expose ports
EXPOSE 7860

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:7860/ || exit 1

# Start command
CMD ["python", "-m", "src.debug_interface"]
